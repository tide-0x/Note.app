<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragment.GroupFragment">

    <TextView
        android:id="@+id/group_management_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/group_management"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/add_group_edit"
        android:textSize="25sp"/>

    <EditText
        android:id="@+id/add_group_edit"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:hint="@string/create_group_from_here"
        android:background="@drawable/shape_edit_bg"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@id/add_group_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/group_management_tv"/>

    <ImageView
        android:id="@+id/add_group_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_add_group"
        app:layout_constraintTop_toTopOf="@id/add_group_edit"
        app:layout_constraintBottom_toBottomOf="@id/add_group_edit"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/group_fragment_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/add_group_edit"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>