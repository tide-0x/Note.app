<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/bottom_dialog_group_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/choose_group"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="20sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bottom_dialog_group_rv"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/bottom_dialog_group_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"/>

    <TextView
        android:id="@+id/bottom_dialog_group_all_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/bottom_dialog_group_rv"
        android:text="@string/all_notes"
        android:gravity="center"
        android:textSize="20sp"/>

    <TextView
        android:id="@+id/bottom_dialog_group_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:text="@string/cancel"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/bottom_dialog_group_all_notes"
        android:gravity="center"/>

</androidx.constraintlayout.widget.ConstraintLayout>